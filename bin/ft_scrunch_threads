#!/usr/bin/env python
from __future__ import print_function
import filtools
import numpy as np
import argparse
import sys
import multiprocessing as mp


parser=argparse.ArgumentParser(description="""'Scrunch' channels and/or samples in the input filterbank.
Output is scaled acording to the normalisation method and the supplied
scale factor. If scrunching by 's' samples and 'c' channels, with a 
scale factor 'F', the result is

out[i] = sum(in[i:i+s][i:i+c]) * F / g + o

where:

g = c*s       for 'mean' normalisation
g = sqrt(c*s) for 'sqrt' normalisation
g = 1.0       for 'sum'  normalisation

and 'o' is a term to remove the addition of the DC offset, defined by

o = D - c*s*D*F/g

Note that o=0 if D=0, or in the case of mean normalisation (with F=1).

Generally mean normalisation is best to prevent overflowing small data
types, but 'sqrt' may better preserve weaker signals.

The values s,c,F,D can be set by the -s, -c, -F and -D options respectively.

This can also be useful to simply re-scale the data with c=1 and s=1.

If reducing number of bits, the output DC offset can also be set using the -O
option. E.g. to convert to 8-bit data to 2-bit data, one might try

 $ ft_scrunch_threads -F 0.02 -b 2 -O 1.5 8bit.fil 2bit.fil

to write 2-bit data with the mean at 1.5 and scaling by a factor of 0.02

** This version is optimised for multi-threaded output **

""",formatter_class=argparse.RawTextHelpFormatter)

parser.add_argument('input', type=str, help="Input filterbank file")
parser.add_argument('output', type=str, help="Output filterbank file")
parser.add_argument('-b', '--bits', type=int, help="Output number of bits (default=same as input)")
parser.add_argument('-N', '--normalise', type=str, help="Normalisation method (default=mean)",default='mean')
parser.add_argument('-c', '--chans', type=int, help='Number of adjacent channels to scrunch (default=1)',default=1)
parser.add_argument('-s', '--samples', type=int, help='Number of adjacent samples to scrunch (default=1)',default=1)
parser.add_argument('-F', '--factor', type=float, help='Scale factor (default=1)',default=1.0)
parser.add_argument('-D', '--dc', type=float, help='DC offset (default=estimate)',default=None)
parser.add_argument('-O', '--offset', type=float, help='Output DC offset (default=input)',default=None)
parser.add_argument('-d', '--dm', type=float, help='Remove DM before scrunching channels (default=don\'t)',default=None)
parser.add_argument('-B', '--blocksize', type=int, help='Set read block size',default=256)
parser.add_argument('-t', '--threads', type=int, help='Number of threads', default=1)
parser.add_argument('--thread-chunk-size', type=int, help='Number of blocks to process per thread', default=64)
parser.add_argument('--no-refdm',action='store_true',help="Don't set the REFDM header field when dedispersing")

args = parser.parse_args()

input = filtools.FilterbankIO()
input.read_header(args.input)


if input.total_channels()%args.chans != 0:
    print("Channel scrunch factor must be a divisor of the number of channels.")
    sys.exit(1)


total_input_samples=input.total_samples()
total_output_samples = total_input_samples // args.samples

print("Read header")
output = input.clone_header()


output.set_frequency_table(input.centre_frequency(),input.channel_bandwidth()*args.chans, input.total_channels()//args.chans)
output.set_sample_interval(input.sample_interval() * args.samples)

if not args.bits is None:
    output.set_bits_per_sample(args.bits)

if not args.dm is None and args.no_refdm==False:
    output.set_reference_dm(args.dm)



scale_factor = args.factor
if args.normalise=="sqrt":
    scale_factor *= 1.0/np.sqrt(args.samples*args.chans)
elif args.normalise=="mean":
    scale_factor *= 1.0/(args.samples*args.chans)
elif args.normalise=="sum":
    pass
else:
    print("Error, normalisation method '{}' not understood".format(args.normalise))
    print("  Should be one of 'sqrt', 'sum', 'mean'.")
    sys.exit(1)


outchans = output.total_channels
dc=args.dc
outputDC=args.offset
dm_const=2.41e-4
blocksize=args.blocksize*args.samples
maxdly=0


if not args.dm is None:
    dm=args.dm
    dly_in = np.power(input.frequency_table(),-2)*dm/dm_const
    dly_out = np.power(output.frequency_table(),-2)*dm/dm_const
    dly = dly_in-np.repeat(dly_out,args.chans)
    bindly = np.round(dly/input.sample_interval()).astype(int)
    maxdly=np.amax(np.abs(bindly))
    blocksize = max(blocksize,4*maxdly)
    total_output_samples -= maxdly

    # We can get a minor performance improvement by
    # applying delays to channels in groups if there are many
    # channels with the same delay
    unique_dly = np.unique(bindly)
    unique_chans = np.zeros((len(unique_dly), len(bindly)),dtype=bool)
    for i,u in np.ndenumerate(unique_dly):
        unique_chans[i] = bindly==u


if blocksize%args.samples != 0:
    blocksize = (blocksize//args.samples+1)*args.samples

print("Block size: {}".format(blocksize))

if dc is None:
    #block = input.read_block(blocksize+maxdly)
    block = input.read_block(blocksize+maxdly)
    dc = np.mean(block)
if outputDC is None:
    outputDC = dc

input.close()

def block_process_thread(start_sample):
    global input
    isample=0
    good=True
    osample=start_sample//args.samples
    #print("START",start_sample)

    if start_sample==0 or args.dm is None: # we don't  need to read a prevblock if we are not dedispersing
        input.seek_to_sample(start_sample)
        prevBlock = None
    else:
        input.seek_to_sample(start_sample-blocksize)
        prevBlock = input.read_block(blocksize+maxdly)

    while good:


        if (not args.dm is None) and (prevBlock is None):
            # Here we are dedispersing and need to read a bit more
            # The first time, so we still have a sensible block size at the end
            block = input.read_block(blocksize + maxdly)
        else:
            block = input.read_block(blocksize)
        if block.shape[0] == 0:
            #print("No data to read")
            break

        if not args.dm is None:

            if prevBlock is None:
                buffer = np.zeros((maxdly, block.shape[1])) + dc
                # ddblock = np.zeros((block.shape[0]-maxdly,block.shape[1]))
                l = block.shape[0] - maxdly
                o = buffer.shape[0]
            else:
                buffer = prevBlock[-2*maxdly:, :]
                l = block.shape[0]
                # ddblock = np.zeros((block.shape[0],block.shape[1]))
                o = buffer.shape[0] - maxdly

            buffer = np.concatenate((buffer, block), axis=0)

            tbuf = buffer.T

            # This strategy of creating a mask and applying it all at once
            # Seems to be about 2x faster than trying to copy slices from
            # the array channel by channel
            mask = np.zeros(tbuf.shape, dtype=bool)
            for i, u in np.ndenumerate(unique_dly):
                mask[unique_chans[i], o + u:o + u + l] = True

            ddblock = tbuf[mask]
            ddblock = ddblock.reshape(block.shape[1], -1).T

            prevBlock = block
            block = ddblock


        offset = outputDC - dc * args.samples * args.chans * scale_factor

        if block.shape[0] % args.samples != 0:
            # At the end of the file, we might not be able to evenly scrunch
            # so, discard the last parts
            maxsamp = (block.shape[0] // args.samples) * args.samples
            block = block[:maxsamp, :]
            good = False

        # Here we scrunch by reshaping and averaging
        cblock = np.sum(block.reshape(block.shape[0], -1, args.chans), axis=2)

        # This feels unpleasent but is not that slow. Might be able to optimise further?
        newblock = np.sum(cblock.T.reshape(cblock.shape[1], -1, args.samples), axis=2).T

        # old slow code
        # newblock = np.add.reduceat(block, np.arange(0, block.shape[0], args.samples),axis=0)
        # newblock = np.add.reduceat(newblock, np.arange(0, block.shape[1], args.chans),axis=1)

        newblock *= scale_factor

        newblock += offset

        #print("Send -> ",osample,newblock.shape)
        output_queue.put((osample,newblock))
        osample += newblock.shape[0]

        isample += block.shape[0]
        if isample >= chunksize:
            break



def thread_init(inf):
    global input
    input = filtools.FilterbankIO()
    input.read_header(inf)


def writer_thread(output_queue):
    output.write_header(args.output)
    written_samples=0
    lastsamp=0
    while 1:
        m = output_queue.get()
        if m == 'EOF':
            output.close()
            break
        else:
            samp,dat = m
            output.seek_to_sample(samp)
            output.write_block(dat)
            written_samples += dat.shape[0]
            print("\r{: 10.2f}% {}/{}".format(100*written_samples/total_output_samples, written_samples,total_output_samples), end="")

chunksize=blocksize*args.thread_chunk_size
manager = mp.Manager()
output_queue = manager.Queue()
pool2 = mp.Pool(1)
pool = mp.Pool(args.threads,initializer=thread_init,initargs=[args.input])
watcher = pool2.apply_async(writer_thread, (output_queue,))

chunks = np.arange(start=0,stop=total_input_samples,step=chunksize)
print("Chunksize={} nchunks={}".format(chunksize,len(chunks)))

print("Start threads")
print("")
jobs = pool.map_async(block_process_thread, chunks )

print("Wait for threads")
jobs.wait()
output_queue.put('EOF')
watcher.wait()
pool.close()
pool.join()
print("")
print("Done")


print("")



