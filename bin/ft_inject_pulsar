#!/usr/bin/env python

from __future__ import print_function, division


import sys
import argparse

import filtools
import filtools.inject_pulsar as ip
import numpy as np


have_t2pred=False
try:
    import t2pred
    have_t2pred=True
except:
    pass


def ft_inject_pulsar(argv):
    parser=argparse.ArgumentParser(description="Inject a pulsar signal into a filterbank file")

    
    
    parser.add_argument('input', type=str, help="Input filterbank file")
    parser.add_argument('-o','--output',type=str, help="Output file name",required=True)

    group=parser.add_argument_group('Pulse profile settings')
    group.add_argument('-p','--pulse', type=str, help="Pulse model type (sin, delta), or profile file to load",default='delta')
    group.add_argument('-S','--flux', type=float, help="Phase averatge flux density (Jy)",default=1.0)
    group.add_argument('-i','--sidx', type=float, help="Spectral index",default=0.0)
    group.add_argument('--sidx-reffreq', type=float, help="Spectral index reference frequency (1400 MHz)",default=1400.0)
    group.add_argument('-E','--pulse-sigma', type=float, help="'sigma' for log-normal pulse intensity distribution",default=0.0)

    group=parser.add_argument_group('Pulse period settings')
    if have_t2pred:
        group.add_argument('--pred', type=str, help="Predictor or polyco for pulsar")
        group.add_argument('--precision-pred', action='store_true', help="Call t2pred for every phase computation - slow")
    else:
        group.add_argument('--pred', type=str, help="t2pred library not found; prints installation help",nargs="?")


    group.add_argument('--f0', type=float, help="Pulse frequency for simple spin model",default=10.0)
    group.add_argument('--f1', type=float, help="Pulse freq 1st derivative for simple spin model",default=0.0)
    group.add_argument('--f2', type=float, help="Pulse freq 2nd derivative for simple spin model",default=0.0)
    group.add_argument('--accn', type=float, help="Pulse accelerationfor simple spin model (overrides F1)",default=None)
    group.add_argument('--pepoch', type=float, help="Epoch of somple spin model (default=centre)",default=None)


    group=parser.add_argument_group('Propagtion settings')
    group.add_argument('-D','--dm', type=float, help="DM of injected pulsar",default=0.0)
    group.add_argument('-x','--no-intra-chan-dm', action='store_false', help="Disable intra-channel DM",dest='intrachan')
    group.add_argument('-c','--scatter-time', type=float, help="Scattering timescale",default=0.0)
    group.add_argument('-X','--scatter-index', type=float, help="Scattering index",default=-4.0)
    group.add_argument('--scatter-reffreq', type=float, help="Scattering index reference frequency (default=1400MHz)",default=1400.0)

    group=parser.add_argument_group('Telescope settings')
    group.add_argument('-T','--site', type=str, help="Telescope description to use.",default=None)
    group.add_argument('--gain', type=float, help="Simulated telescope gain (K/Jy)",default=1.0)
    group.add_argument('--tsys', type=float, help="Simulated telescope tsys (K)",default=25.0)
    group.add_argument('--npol', type=int, help="Number of polarisations already averaged",default=2)
    group.add_argument('--rms', type=float, help="RMS in input data (default=auto)",default=None)
    group.add_argument('--blocksize', type=int, help="Block size (default=256)",default=256)

    group=parser.add_argument_group('Interference signals')
    group.add_argument('--rfi-config', type=str, default=None, help='RFI configuration yaml file')
    group.add_argument('--remove-signed', action='store_true', help='Set this flag to remove the signed option from the header of the filterbank file')


    args=parser.parse_args(argv[1:])

    print(args)

    # First try to open the input file.
    infile = filtools.FilterbankIO()
    infile.read_header(args.input)
    print(infile.header)
    freqs=infile.frequency_table()
    #read_block = infile.get_reader()

    # Set up phase predictor. This will tell the pulse model what phase to model
    # For each time step.
    if args.pred is None:
        if args.pepoch is None:
            pepoch=infile.mjd_at_sample(infile.total_samples()//2)
        else:
            pepoch=args.pepoch
        phase_model = ip.simple_phase_model(epoch=pepoch,f0=args.f0,f1=args.f1,f2=args.f2,accn=args.accn)
    else:
        if have_t2pred:
            pred = t2pred.phase_predictor(args.pred)
            if args.precision_pred:
                phase_model = ip.precision_predictor_phase_model(pred)
            else:
                phase_model = ip.predictor_phase_model(pred)
            pass
        else:
            print("NOTICE: The --pred option allows you to use a phase predictor to inject")
            print("        a pulsar that tracks an arbitrary pulsar par file. However, this")
            print("        requires the installation of the t2pred library from tempo2.")
            print("")
            print("        Install from the tempo2 source directory by running")
            print("         $ python setup.py install")
            print("        in the tempo2/python/t2pred directory.")
            sys.exit(2)



    # Set up pulse model. There are special keywords here, otherwise assume it is a file.
    if args.pulse == "sin":
        pulse_model=ip.sinusoid_pulse_model(phase_model=phase_model,freq=freqs)
    elif args.pulse == "delta":
        pulse_model=ip.delta_pulse_model(phase_model=phase_model,freq=freqs)
    else:
        prof_dat = np.loadtxt(args.pulse,usecols=(0))
        pulse_model=ip.piecewise_pulse_model(phase_model=phase_model,freq=freqs,profile=prof_dat)

    # Set up ISM
    if args.scatter_time > 0:
        # If we want to include scattering, we need a scattering model between
        # The pulse model and the dispersion model
        scatter_model = ip.simple_scattering_model(input=pulse_model,freq=freqs,t_scatt=args.scatter_time,dx=infile.sample_interval(), scatt_idx=args.scatter_index,ref_freq=args.scatter_reffreq)
    else:
        # Otherwise, we don't do any scattering.
        scatter_model = pulse_model

    # This will do nothing if dm is zero, so always include it.
    ism_model = ip.simple_propagation_model(input=scatter_model, freq=freqs, dm=args.dm, intra_chan=args.intrachan)

    # Just to re-name the variable for the final model
    inject_model = ism_model


    # Set up RFI injection if required
    rfi_model = None
    if args.rfi_config:
        rfi_model = ip.inject_rfi()
        if rfi_model.configure_db(filename=args.rfi_config, nchans=infile.header['nchans'], fch1=infile.header['fch1'],
                                     foff=infile.header['foff'],tsamp=infile.header['tsamp']):
            print('Configuration of RFI blocks completed..')
        else:
            print('Oops! Failed to configure RFI blocks\nContinuing without RFI injection')
            rfi_model = None

    # Set up telecsope

    rms=args.rms
    offset=0
    if rms is None or offset is None:
        block = infile.read_block(2048)
        if rms is None:
            rms=np.std(block)
        if offset is None:
            offset = np.mean(block)
        infile.seek_to_sample(0)
            
    print("RMS: {:.2f} offset: {:.2f}".format(rms,offset))
    scaler = filtools.FluxScale()
    scaler.tsys=args.tsys
    scaler.offset=0 # We are injecting so we scale to zero offset.
    scaler.rms=rms
    if args.site is None:
        scaler.gain=args.gain
    else:
        scaler.set_gain_from_file("{}.yaml".format(args.site.lower()))
    scaler.init(bw=infile.channel_bandwidth(),tsamp=infile.sample_interval(),npol_avg=args.npol)

    # Start working on the ouput file
    ofil=infile.clone_header()
    if args.remove_signed:
        del ofil.header['signed']   #Strips away the fil.header.signed parameter from the header of the file
    ofil.write_header(args.output)
    write_block = ofil.get_writer()


    if infile.header['nbits']==32:
        integerise_if_needed = lambda x:x
    else:
        integerise_if_needed = filtools.SimpleIntegerise()
# Begin working on the data
    mjdref=infile.mjd_at_sample(0)
    isamp=0
    while True:
        block = infile.read_block(args.blocksize)
        print("\r{: 10.2f}s".format(infile.seconds_since(isamp,mjdref)),end="")
        if block.shape[0]==0:
            break

        bsamp=block.shape[0]
        samps = np.arange(isamp,isamp+bsamp,dtype=int)
        bin_start = np.repeat(infile.seconds_since(samps,mjdref),repeats=infile.total_channels()).reshape(bsamp,-1)
        bin_end = np.repeat(infile.seconds_since(samps+1,mjdref),repeats=infile.total_channels()).reshape(bsamp,-1)

        spec = args.flux*inject_model(bin_start,bin_end,mjdref)
        
        if rfi_model is not None:
            #Injecting RFI into the block
            spec += scaler.to_flux_units(rfi_model.injector(isamp,bsamp)*rms)

        spec = integerise_if_needed(scaler.to_file_units(spec))
        
        block += spec
        isamp += bsamp

        write_block(block)
    ofil.close()
    print("")



if __name__ == "__main__":
    ft_inject_pulsar(sys.argv)

